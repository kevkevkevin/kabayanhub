rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /* ───────── helpers ───────── */
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    // Block links (http, https, www, .com, .net, .org, etc.)
    function hasLink(txt) {
      return txt.matches('(?i).*\\b(http|https)://.*') ||
             txt.matches('(?i).*\\bwww\\..*') ||
             txt.matches('(?i).*\\b[^\\s]+\\.(com|net|org|io|app|co|me|sa|ph)\\b.*');
    }

    function isValidChatCreate() {
      return request.resource.data.keys().hasAll(['uid','username','type','createdAt']) &&
        request.resource.data.uid == request.auth.uid &&
        (request.resource.data.type == "text" || request.resource.data.type == "sticker") &&
        request.resource.data.username is string &&
        request.resource.data.username.size() >= 2 &&
        request.resource.data.username.size() <= 24 &&
        request.resource.data.createdAt is timestamp &&
        (
          (request.resource.data.type == "text" &&
            request.resource.data.text is string &&
            request.resource.data.text.size() >= 1 &&
            request.resource.data.text.size() <= 220 &&
            !hasLink(request.resource.data.text) &&
            (!('stickerId' in request.resource.data) || request.resource.data.stickerId == null)
          )
          ||
          (request.resource.data.type == "sticker" &&
            request.resource.data.stickerId is string &&
            request.resource.data.stickerId.size() >= 1 &&
            request.resource.data.stickerId.size() <= 64 &&
            (!('text' in request.resource.data) || request.resource.data.text == null)
          )
        );
    }

    /* ───────── users ───────── */
    match /users/{userId} {
      allow read: if isSignedIn();
      // Signup may only create an ordinary user. Role assignment belongs to
      // trusted server code / the Firebase console, never a client write.
      allow create: if isSignedIn() && request.auth.uid == userId
        && request.resource.data.role == "user";
      // affectedKeys includes additions and removals, so this also protects
      // legacy profiles without a role and full-document replacement writes.
      allow update: if isSignedIn() && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']);
      allow delete: if false;
    }

    match /users/{userId}/activity/{docId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    match /users/{userId}/budgetEntries/{docId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    match /users/{userId}/calorieEntries/{docId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    /* ───────── social community (no points rewards) ───────── */
    function ownsSocialProfile(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    function hasSocialProfile() {
      return isSignedIn() && exists(/databases/$(database)/documents/socialProfiles/$(request.auth.uid));
    }
    function validSocialProfile(uid) {
      let data = request.resource.data;
      return data.keys().hasOnly(['username', 'displayName', 'bio', 'photoPath', 'createdAt', 'updatedAt'])
        && data.username is string && data.username.matches('^[a-z0-9_]{3,20}$')
        && data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 50
        && data.bio is string && data.bio.size() <= 160
        && (data.photoPath == '' || data.photoPath == 'social/avatars/' + uid + '/avatar.jpg')
        && data.createdAt is timestamp && data.updatedAt == request.time
        && getAfter(/databases/$(database)/documents/socialHandles/$(data.username)).data.uid == uid;
    }
    match /socialProfiles/{uid} {
      allow read: if true;
      allow create: if ownsSocialProfile(uid) && validSocialProfile(uid) && request.resource.data.createdAt == request.time;
      allow update: if ownsSocialProfile(uid) && validSocialProfile(uid)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;
      match /following/{target} {
        allow read: if ownsSocialProfile(uid);
        allow create: if ownsSocialProfile(uid) && hasSocialProfile() && uid != target
          && exists(/databases/$(database)/documents/socialProfiles/$(target))
          && request.resource.data.keys().hasOnly(['createdAt'])
          && request.resource.data.createdAt == request.time;
        allow update: if false;
        allow delete: if ownsSocialProfile(uid);
      }
    }
    match /socialHandles/{handle} {
      allow get: if true;
      allow list: if false;
      allow create: if ownsSocialProfile(request.resource.data.uid)
        && request.resource.data.keys().hasOnly(['uid'])
        && handle.matches('^[a-z0-9_]{3,20}$')
        && getAfter(/databases/$(database)/documents/socialProfiles/$(request.auth.uid)).data.username == handle;
      allow update: if false;
      allow delete: if ownsSocialProfile(resource.data.uid)
        && getAfter(/databases/$(database)/documents/socialProfiles/$(request.auth.uid)).data.username != handle;
    }
    function validSocialText(maxLength) {
      let data = request.resource.data;
      return hasSocialProfile() && data.keys().hasOnly(['uid', 'text', 'createdAt'])
        && data.uid == request.auth.uid && data.text is string
        && data.text.size() > 0 && data.text.size() <= maxLength && data.text.matches('(?s).*[^\\s].*')
        && data.createdAt == request.time;
    }
    match /socialPosts/{postId} {
      allow read: if true;
      allow create: if validSocialText(500);
      allow update: if false;
      allow delete: if ownsSocialProfile(resource.data.uid) || isAdmin();
      match /likes/{uid} {
        allow read: if exists(/databases/$(database)/documents/socialPosts/$(postId));
        allow create: if ownsSocialProfile(uid)
          && exists(/databases/$(database)/documents/socialPosts/$(postId))
          && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
          && request.resource.data.uid == uid && request.resource.data.createdAt == request.time;
        allow update: if false;
        allow delete: if ownsSocialProfile(uid);
      }
      match /replies/{replyId} {
        allow read: if exists(/databases/$(database)/documents/socialPosts/$(postId));
        allow create: if exists(/databases/$(database)/documents/socialPosts/$(postId)) && validSocialText(280);
        allow update: if false;
        allow delete: if ownsSocialProfile(resource.data.uid) || isAdmin();
      }
    }
    match /socialReports/{reportId} {
      allow get: if isSignedIn() && (!exists(/databases/$(database)/documents/socialReports/$(reportId)) || resource.data.uid == request.auth.uid || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(['uid', 'postId', 'reason', 'status', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && reportId == request.resource.data.postId + '_' + request.auth.uid
        && exists(/databases/$(database)/documents/socialPosts/$(request.resource.data.postId))
        && request.resource.data.reason in ['spam', 'abuse', 'scam', 'other']
        && request.resource.data.status == 'open' && request.resource.data.createdAt == request.time;
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedAt'])
        && request.resource.data.status in ['reviewed', 'removed']
        && request.resource.data.reviewedAt == request.time;
      allow delete: if false;
    }

    /* ───────── news ───────── */
    match /news/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    /* ───────── videos ───────── */
    match /videos/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    /* ───────── marketplace items (KP rewards marketplace) ───────── */
    match /marketplaceItems/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /marketplacePurchases/{id} {
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid;

      allow read: if isAdmin() ||
        (isSignedIn() && request.auth.uid == resource.data.userId);

      allow update, delete: if isAdmin();
    }

    /* ───────── tambayan stickers ───────── */
    match /tambayanStickers/{stickerId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    /* ───────── tambayan chat ───────── */
    match /tambayanChat/{messageId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidChatCreate();
      allow update: if false;
      allow delete: if isAdmin();
    }

    /* ───────── tambayan config ───────── */
    match /tambayanConfig/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /tambayanLive/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    /* ───────── moments ───────── */
    match /moments/{momentId} {
      allow read: if true;

      allow create: if isSignedIn()
        && request.resource.data.keys().hasAll(['uid','username','text','createdAt','expiresAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username is string
        && request.resource.data.username.size() >= 2
        && request.resource.data.username.size() <= 24
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1
        && request.resource.data.text.size() <= 220
        && !hasLink(request.resource.data.text)
        && request.resource.data.createdAt is timestamp
        && request.resource.data.expiresAt is timestamp;

      allow update: if false;
      allow delete: if isAdmin() || (isSignedIn() && request.auth.uid == resource.data.uid);
    }

    /* ───────── Kabayan Market (public market) ───────── */

    // Restaurants
    match /marketRestaurants/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Supermarkets
    match /marketSupermarkets/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ✅ Products (ONE SOURCE OF TRUTH)
    // Use this for admin + public product list
    match /marketProducts/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    /* ───────── Job Board ───────── */

    // Jobs - admin can manage, all authenticated users can read
    match /jobs/{jobId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // Job Applications - users can manage their own, admins can read/update all
    match /jobApplications/{applicationId} {
      allow create: if isSignedIn() &&
        request.resource.data.uid == request.auth.uid;

      allow read: if isAdmin() ||
        (isSignedIn() && request.auth.uid == resource.data.uid);

      allow update, delete: if isAdmin();
    }

    match /arabicWordRushConfig/{weekId} {
      allow read: if true;          // public can play
      allow create, update, delete: if isAdmin(); // admin updates weekly
    }

  }
}
