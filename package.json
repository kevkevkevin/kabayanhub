{
  "name": "kabayanhub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "test:word-rush": "node --test tests/arabic-word-rush.test.cjs",
    "test:rules": "node --test tests/supabase.test.cjs",
    "test:social": "node --test tests/supabase.test.cjs",
    "test:legacy:rules": "firebase emulators:exec --project demo-kabayan-rules --only firestore --config firebase.rules-test.json \"node --test tests/firestore-rules.test.cjs\"",
    "test:legacy:social": "firebase emulators:exec --project demo-kabayan-social --only firestore,storage --config firebase.social-test.json \"node --test tests/social-rules.test.cjs\"",
    "test": "node --import tsx --test tests/supabase.test.cjs tests/arabic-word-rush.test.cjs tests/backend.test.ts",
    "test:hosted": "node scripts/verify-supabase.cjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.109.0",
    "next": "^16.2.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-markdown": "^10.1.0",
    "react-quill-new": "^3.7.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.16",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "baseline-browser-mapping": "^2.10.20",
    "eslint": "^9",
    "eslint-config-next": "16.0.4",
    "firebase": "^12.19.0",
    "firebase-tools": "^15.12.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "ws": "^8.22.0"
  },
  "engines": {
    "node": "24.x"
  }
}
